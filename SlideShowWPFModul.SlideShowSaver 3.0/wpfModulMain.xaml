<Window x:Class="wpfModulMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SlideShowSaver 3.0"
        Background="Black"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        Topmost="False"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown">
   
    <Grid>
        <Label x:Name="lblPräsentationsschirm" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center" 
               FontSize="48" 
               FontWeight="Bold"
               Foreground="White" 
               Content="SlideShowSaver 3.0"
               Visibility="Hidden"/>
        <Image x:Name="imgAnzeige" Stretch="Uniform"/>
    </Grid>
    
</Window>
