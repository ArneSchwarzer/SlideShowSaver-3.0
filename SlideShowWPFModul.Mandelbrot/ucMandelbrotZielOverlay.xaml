<UserControl x:Class="ucMandelbrotZielOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             IsHitTestVisible="False">

    <Grid x:Name="grdOverlay"
          Background="Transparent"
          ClipToBounds="True">

        <Border x:Name="brdInformation"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#80000000"
                BorderThickness="0"
                CornerRadius="18"
                Padding="28,16"
                Visibility="Collapsed">

            <Grid>

                <!-- Linksbündige Koordinatenanzeige -->
                <TextBlock x:Name="txbKoordinaten"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0"
                           FontFamily="Segoe UI"
                           FontSize="16"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0" />

                <!-- Geometrisch zentrierter Zielname -->
                <TextBlock x:Name="txbZielname"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="20,0"
                           FontFamily="Segoe UI"
                           FontSize="40"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Rechtsbündige Renderinformationen -->
                <TextBlock x:Name="txbRenderInformationen"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"
                           FontFamily="Segoe UI"
                           FontSize="16"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0" />

            </Grid>

        </Border>

    </Grid>

</UserControl>