<Window x:Class="wpfModulMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mandelbrot"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        Topmost="False"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown">
    
    <Grid>
        <!-- Hauptbild, immer Vollbild -->
        <Rectangle x:Name="rctMandelbrot"            
            Stretch="Fill"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"/>
        
        <!-- Präsentations‑TextBlock in Bildschirmmitte -->
        <TextBlock x:Name="txbPraesentationsschirm"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             TextAlignment="Center"
             FontSize="48"
             FontWeight="Bold"                   
             Text="Mandelbrot"
             TextWrapping="Wrap"/>
        <!-- Standard: unsichtbar -->
        <Grid x:Name="grdMultipassTest"
      Background="Black"
      Visibility="Collapsed">

            <!-- Pass 1: bleibt Bestandteil des Visual Trees,
         wird aber visuell vom Endpass überdeckt. -->
            <Grid x:Name="grdMultipassPass1"
          IsHitTestVisible="False">

                <Grid.CacheMode>
                    <BitmapCache RenderAtScale="1"
                         EnableClearType="False"
                         SnapsToDevicePixels="False" />
                </Grid.CacheMode>

                <Rectangle x:Name="rctMultipassPass1"
                   Fill="White"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" />

            </Grid>

            <!-- Pass 2 -->
            <Grid x:Name="grdMultipassPass2"
          IsHitTestVisible="False">

                <Grid.CacheMode>
                    <BitmapCache RenderAtScale="1"
                         EnableClearType="False"
                         SnapsToDevicePixels="False" />
                </Grid.CacheMode>

                <Rectangle x:Name="rctMultipassPass2"
                   Fill="White"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" />

            </Grid>

            <!-- Pass 3 / sichtbares Endergebnis -->
            <Grid x:Name="grdMultipassPass3"
          IsHitTestVisible="False">

                <Rectangle x:Name="rctMultipassPass3"
                   Fill="White"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" />

            </Grid>

        </Grid>
    </Grid>
</Window>
