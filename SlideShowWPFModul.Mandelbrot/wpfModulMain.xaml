<Window x:Class="wpfModulMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SlideShowWPFModul.Mandelbrot"
        Title="Mandelbrot"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Grid x:Name="grdHauptbereich">

        <Rectangle x:Name="rctMandelbrot"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch" />

        <local:ucMandelbrotZielOverlay
            x:Name="ucZielOverlay"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False"
            Panel.ZIndex="10"
            Visibility="Collapsed" />

        <TextBlock x:Name="txbPraesentationsschirm"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   FontSize="48"
                   FontWeight="Bold"          
                   Visibility="Collapsed"
                   Panel.ZIndex="20" />
        

    </Grid>

</Window>