<Window x:Class="wpfModulMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mandelbrot"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        Topmost="False"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown">

    <Grid x:Name="grdHauptbereich"          
          ClipToBounds="True">

        <!-- Aktuelle Mandelbrot-Ausgabe -->
        <Rectangle x:Name="rctMandelbrot"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Stretch="Fill" />

        <!-- Präsentationsschirm beim Modulstart -->
        <TextBlock x:Name="txbPraesentationsschirm"
                   Margin="40"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   MaxWidth="1200"
                   Text="Mandelbrot"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="48"
                   FontWeight="Bold"
                   Foreground="White"
                   IsHitTestVisible="False" />

    </Grid>

</Window>